{
  "paper_claims": [
    {
      "id": "C1",
      "claim": "EBO analyst-based value (V_f) is highly correlated with contemporaneous stock price, and the V_f/P ratio predicts long-horizon cross-sectional stock returns.",
      "paper_location": "L22-23",
      "headline": true
    },
    {
      "id": "C2",
      "claim": "V_f/P predicts long-term returns even after controlling for B/P and firm size.",
      "paper_location": "L23-24"
    },
    {
      "id": "C3",
      "claim": "Cross-sectional errors in the three-year-ahead I/B/E/S consensus forecast are predictable by B/P, SG, OP, and Ltg.",
      "paper_location": "L24-25"
    },
    {
      "id": "C4",
      "claim": "A zero-investment strategy combining top-quintile V_f/P with bottom-quintile PErr yields positive 36-month buy-and-hold returns above either strategy alone.",
      "paper_location": "L25-26"
    }
  ],
