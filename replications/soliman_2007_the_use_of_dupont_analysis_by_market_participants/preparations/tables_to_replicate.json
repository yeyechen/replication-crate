{
  "paper_claims": [
    {
      "id": "C1",
      "claim": "\u0394ATO positively predicts future changes in RNOA after controlling for \u0394RNOA, AB controls, and RSST accruals (the central DuPont forecasting result).",
      "paper_location": "L572",
      "headline": true
    },
    {
      "id": "C2",
      "claim": "\u0394ATO is significantly positively associated with contemporaneous 12-month buy-hold market-adjusted returns, incremental to earnings and \u0394EARN.",
      "paper_location": "L608",
      "headline": true
    },
    {
      "id": "C3",
      "claim": "\u0394ATO is associated with future abnormal stock returns (annual abnormal return ~5%) even after controlling for Fama-French factors and RSST accruals, indicating incomplete processing.",
      "paper_location": "L624",
      "headline": true
    },
    {
      "id": "C4",
      "claim": "\u0394ATO is significantly positively associated with analyst forecast revisions of next-year earnings, incremental to earnings surprise and \u0394RNOA.",
      "paper_location": "L638"
    },
    {
      "id": "C5",
      "claim": "Future forecast errors for year t+1 are predictable by \u0394ATO and \u0394PM, suggesting analysts do not fully incorporate DuPont information.",
      "paper_location": "L640-642"
    }
  ],
