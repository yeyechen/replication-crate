{
  "paper_claims": [
    {
      "id": "C1",
      "claim": "Stocks with the highest maximum daily return over the prior month (MAX) earn significantly lower future returns than stocks with the lowest MAX; VW D10-D1 spread is -1.03% per month and the FF-Carhart 4-factor alpha difference is -1.18% per month, both statistically significant.",
      "paper_location": "L84",
      "headline": true
    },
    {
      "id": "C2",
      "claim": "The negative MAX-return relation is robust to controls for size (SIZE), book-to-market (BM), momentum (MOM), short-term reversal (REV), and illiquidity (ILLIQ) in bivariate sorts and in multivariate Fama-MacBeth regressions.",
      "paper_location": "L92"
    },
    {
      "id": "C3",
      "claim": "Including MAX in the regression reverses the anomalous negative idiosyncratic-volatility (IVOL) effect: once MAX is controlled for, the IVOL slope becomes positive and statistically significant.",
      "paper_location": "L94"
    },
    {
      "id": "C4",
      "claim": "MAX is persistent: lagged MAX is a strong cross-sectional predictor of current MAX even after including seven control variables (Table 3, R^2 ~35%).",
      "paper_location": "L90"
    }
  ],
  "budget_flag": null,
