    {
      "id": "T4",
      "table_ref": "Table 4, Panel A",
      "description": "QMJ factor returns and factor loadings, US Long Sample 7/1957-12/2016",
      "replication_meaning": "Demonstrates correct QMJ factor construction via 2x3 conditional sorts (size then quality), with median NYSE market equity as the size breakpoint and top/bottom 30% quality cutoffs within each size group. Validates that the QMJ = 1/2(Small Quality + Big Quality) - 1/2(Small Junk + Big Junk) formula produces a factor with significant 4-factor alpha (0.60%, t=9.95) and negative MKT/SMB/HML loadings, confirming the paper's central claim that high-quality stocks earn high risk-adjusted returns despite being safer.",
      "paper_quote": "QMJ factors are constructed as the intersection of six value-weighted portfolios formed on size and quality. At the end of each calendar month, stocks are assigned to two size-sorted portfolios based on their market capitalization. For U.S. securities, the size breakpoint is the median NYSE market equity. We use conditional sorts, first sorting on size and then on quality. (L2057)",
      "exercises_preprocessing_rules": [
        "universe_common_stock",
        "sample_long_period",
        "sort_qmj_construction",
        "sort_qmj_top_bottom_30",
        "sort_qmj_formula",
        "sort_weighting_vw",
        "factor_four_factor",
        "var_quality_composite"
