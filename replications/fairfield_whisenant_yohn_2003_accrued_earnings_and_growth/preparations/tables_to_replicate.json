{
  "paper_claims": [
    {
      "id": "C1",
      "claim": "Sloan (1996) result replicates: the accrual component of operating income is less persistent than the cash component for one-year-ahead ROA (eq. 2: beta_ACC = 0.676, beta_CFO = 0.737, paired-t = 4.58).",
      "paper_location": "L335-339"
    },
    {
      "id": "C2",
      "claim": "FWY main contribution (Hypothesis 1): conditioned on current ROA, GrLTNOA is negatively associated with one-year-ahead ROA with the same severity as ACC (eq. 4: alpha_2_ACC = -0.061, alpha_3_GrLTNOA = -0.039; paired-t for equality = -1.21, not significant).",
      "paper_location": "L153-156, L1114-1120, L1145-1148"
    },
    {
      "id": "C3",
      "claim": "Denominator-effect hypothesis (Hypothesis 2): when the dependent variable uses LAGGED average total assets (eqs. 5, 6), ACC and GrLTNOA exhibit non-negative associations with one-year-ahead operating income (eq. 5 gamma_ACC = -0.121 t=-0.65; eq. 6 delta_3_GrLTNOA = 0.030 t=2.20, paired-t for equality = -1.50 not significant).",
      "paper_location": "L157-161, L1215-1226, L1255-1258"
    },
    {
      "id": "C4",
      "claim": "Mishkin-test hypothesis (Hypothesis 3): investors appear to overweight both ACC and GrLTNOA in pricing relative to their predictive abilities (gamma*_2_ACC = 0.069 vs gamma_2_ACC = -0.045, LR = 103.90; gamma*_3_GrLTNOA = 0.051 vs gamma_3_GrLTNOA = -0.048, LR = 110.58), but the overpricing of the two components is statistically equivalent (joint LR = 1.82, p = 0.403).",
      "paper_location": "L443-449, L1330-1344, L1364-1381"
    }
  ],
