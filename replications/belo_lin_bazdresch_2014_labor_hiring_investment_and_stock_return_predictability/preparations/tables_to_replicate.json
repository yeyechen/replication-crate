{
  "paper_claims": [
    {
      "id": "C1",
      "claim": "In firm-level regressions, a 10 percentage points increase in the firm's current hiring rate is associated with a 1.5 percentage points decrease in the firm's annual future stock return (i.e., hiring is negatively related to future returns).",
      "paper_location": "L58",
      "headline": true
    },
    {
      "id": "C2",
      "claim": "In portfolio sorts, a long low-hiring/short high-hiring portfolio earns an average annual excess return of 5.6% (VW) to 10.4% (EW) - the 'hiring return spread' is positive and statistically significant.",
      "paper_location": "L78"
    },
    {
      "id": "C3",
      "claim": "Hiring contains information about future returns not fully contained in investment: a 10pp increase in hiring predicts 0.7-1.5pp lower annual return after controlling for investment, and vice-versa.",
      "paper_location": "L264"
    },
    {
      "id": "C4",
      "claim": "CAPM cannot explain the hiring return spread (CAPM betas go the wrong way); Fama-French three-factor model explains more of the spread but still leaves a large abnormal return on the L-H portfolio (e.g., 8.59% per annum EW, all firms).",
      "paper_location": "L282-286"
    }
  ],
  "budget_flag": "Total committed cells exceed 350: Table 1 (10 one-way portfolios x {r^e, [t], SR, alpha, t, b, t, R^2, alpha^F, t, b, s, h, R^2} x 3 weighting panels = ~120 cells), Table 2 (12 characteristics x 6 columns = 72, minus TFP = 60), Table 3 (9 portfolio cells + L-H + [t] rows x 3 weighting panels for {r^e, alpha, alpha^F} = ~150), Table 4 (4 cols x 2 methods x ~7 rows = ~50). All four tables are required because each paper claim (C1-C4) is empirically tested in a different table; coverage is the priority over cell count.",
